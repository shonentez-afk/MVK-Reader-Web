```powershell
# Из папки tools/research/stage111z31r_x32dbg_two_mode_capture/
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "Prepare-Capture.ps1" -Adc 4 -N 262144 -SpectrumType 0 -Root "C:\MVK_CAPTURE\GIGACODE_LOG_MODE0"
```

