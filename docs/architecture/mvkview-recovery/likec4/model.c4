// Public architecture only. Original MVKView 1.0.47 and its IDR/Pascal
// evidence are private and are NOT represented in this public model.
// Code snapshot: dd020c4a8c1cd9d80440031730b7c4ee28bf8cef; no runtime or hardware parity claimed.
specification {
  element system
  element component
  element actor
}

model {
  stage111 = system 'MVKView Compatible Stage111' {
    description 'Восстанавливаемое Windows desktop-приложение. Структура из активных Python/Qt и Go исходников. Не MVK Live и не веб-ридер.'

    entry = component 'Desktop/CLI entrypoint' {
      description 'Запускает Qt desktop или локальную проверку архива по явному флагу CLI. Источник: mvk_compatible/__main__.py.'
      link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/mvk_compatible/__main__.py#L5
      technology 'Python'
    }

    desktop = component 'Qt desktop and original shell' {
      description 'MainWindow, вкладки, события измерения и интерфейсные представления. Выполняет вызовы Core и управляет локальным native helper.'
      link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/mvk_compatible/desktop/main_window.py#L151
      technology 'PySide6'
    }

    core = component 'Python Core' {
      description 'Проверка состояний, обработка выборок и файловые контракты. Содержит исследовательские и production варианты, не все гарантированно активны.'

      measurement = component 'Measurement/Task2 source model' {
        description 'Модель состояний original Mode2 и проверяемые события Task2. Не подменяет передачу команд реальному прибору.'
        link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/mvk_compatible/core/original_mode2_task2_exchange.py#L42
        technology 'Python'
      }

      signal = component 'GetSignal and spectral processing' {
        description 'Модули расчётов временного сигнала и спектра, в том числе FIR, FFT, режимы амплитуды. Некоторые части source-derived или кандидаты и не являются Win32 runtime oracle.'
        link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/mvk_compatible/core/original_getsignal_live_source.py#L23
        technology 'Python/NumPy'
      }

      livespectrum = component 'LIVE full spectrum view and LOD' {
        description 'Проверяет ADC/mode/window SHA, PRE/POST-FIR N/Fs и сохраняет полный неизменяемый N/2 массив. Отдельная отрисовка min/max LOD не является источником курсора или summary. Исходный Win32 паритет не доказан.'
        link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/mvk_compatible/core/original_live_spectrum_view.py#L16
        technology 'Python/NumPy'
      }

      livestatus = component 'LIVE operator PageStatus' {
        description 'Единый принятый PARAM snapshot; RESULT/BAND/TACH таблицы и отдельный SPEC chart, Freeze/Stop binding. Win32 parity not attested.'
        link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/mvk_compatible/core/original_live_operator_status.py#L69
        technology 'Python'
      }

      pagefile = component 'PageFile writer selection and locks' {
        description 'Две независимые машины записи, общая маска каналов, фиксация BEGIN для END; local frame-mark IPC. Не доказательство original Win32 parity.'
        link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/mvk_compatible/core/original_live_pagefile.py#L233
        technology 'Python'
      }

      preview = component 'Native preview / provenance' {
        description 'Проверяет локальный RX/PARAM snapshot и источник live данных. Не аппаратный эталон или подтверждённый Win32 DSP.'
        link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/mvk_compatible/core/native_r6_live_preview.py#L25
        technology 'Python'
      }

      valueformat = component 'GetValueText format candidate' {
        description '30 независимых типов форматирования параметров; это не 15 режимов PageStatus. Точный оригинальный Win32 вывод не аттестован.'
        link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/mvk_compatible/core/original_get_value_text_30.py#L183
        technology 'Python'
      }

      filecontracts = component 'TSXML and output contracts' {
        description 'Формирование и проверка имен, структур TSXML и локальных экспортов по верифицированным данным.'
        link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/mvk_compatible/core/original_mode2_source_files.py#L109
        technology 'Python'
      }

      parity = component 'Same-RAW evidence checks' {
        description 'Сопоставляет переданные файлы и стадии расчётов; строгий file-gate не подтверждает физическую Win32/MVK01 сессию.'
        link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/mvk_compatible/core/original_mode2_paired_acceptance.py#L166
        technology 'Python'
      }
    }

    native = component 'Native R6.1 Go receiver' {
      description 'Локальный TCP/10230 приёмник и Go экспорт с применением разрешённых оператором сетевых действий. Тесты и симуляции не доказывают реальную аппаратную совместимость.'
      link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/tools/research/native_tcp10230_stage108_live_recording_r6_1/source/main.go
      technology 'Go'
    }

    localfiles = component 'Local RAW/BIN/TSXML/VALUES/TABLE' {
      description 'Локальные артефакты записи и офлайн-анализа. Форматы и фактическая односеансная идентичность оригиналу требуют отдельной проверки.'
    }

    entry -> desktop 'Запускает реальную Qt-оболочку'
    desktop -> core.measurement 'Вызывает модели состояния Mode2'
    desktop -> core.preview 'Проверяет происхождение текущего RX/ADC/PARAM snapshot'
    localfiles -> desktop 'Читает локальный проверяемый статус и архивы, не прямой Go call'
    desktop -> core.signal 'Запрашивает обработку данных и представления графиков'
    desktop -> core.livespectrum 'Привязывает полный LIVE FFT к ADC/window/mode; получает массив для X/Y и курсора'
    core.livespectrum -> core.signal 'Проверяет контракт результата спектрального расчёта'
    desktop -> core.livestatus 'Отображает принятые PARAM значения и связывает Freeze/Stop с таблицами'
    desktop -> core.pagefile 'Применяет блокировки и фиксирует выбор записи'
    desktop -> native 'Управляет разрешённой локальной записью'
    native -> localfiles 'Сохраняет измерительные и служебные данные'
    core.filecontracts -> localfiles 'Формирует/проверяет локальные контракты'
    core.parity -> localfiles 'Проверяет предоставленные локальные эталоны'
  }

  mvk01 = actor 'Физический МВК01' {
    description 'Внешний измерительный прибор. Полная оригинальная сессия IP→Измерить→Task2→RX→Stop на одном потоке НЕ аттестована.'
  }
  quality = component 'CI and research tests' {
    description 'Проверяет synthetic contracts, статические зависимости и десктопные тесты. Тестовые результаты не являются подтверждением original 1:1.'
    link https://github.com/shonentez-afk/MVK-Reader-Web/blob/dd020c4a8c1cd9d80440031730b7c4ee28bf8cef/mvk_compatible/tests/test_desktop_qt.py
  }

  stage111.native -> mvk01 'TCP/10230; только с разрешения оператора'
  quality -> stage111.core 'Автоматические синтетические проверки'
}
